{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BatPlayer",
  "version": "0.1.0",
  "identifier": "com.batplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "publisher": "BatSoft",
    "shortDescription": "A modern media player",
    "longDescription": "BatPlayer is a modern desktop media player for video and audio, with playlists, playback speed controls, subtitles, and a compact mini player.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "mpv/libmpv-2.dll": "libmpv-2.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true,
        "template": "nsis/installer.nsi"
      }
    }
  }
}
